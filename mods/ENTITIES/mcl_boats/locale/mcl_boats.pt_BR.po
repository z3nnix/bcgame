#: mods/ENTITIES/mcl_boats/init.lua:166
msgid "Sneak to dismount"
msgstr "Agache para sair"

#: mods/ENTITIES/mcl_boats/init.lua:632
msgid "Boats are used to travel on the surface of water."
msgstr "Botes são usados para viajar na superfície da água."

#: mods/ENTITIES/mcl_boats/init.lua:633
msgid ""
"Rightclick on a water source to place the boat. Rightclick the boat to enter "
"it. Use [Left] and [Right] to steer, [Forwards] to speed up and [Backwards] "
"to slow down or move backwards. Use [Sneak] to leave the boat, punch the "
"boat to make it drop as an item."
msgstr ""
"Clique com o botão direito em uma fonte de água para posicionar o bote. "
"Clique com o botão direito no bote para entrar nele. Use [Esquerda] e "
"[Direita] para fazer curva, [Frente] para acelerar e [Trás] para frear e ir "
"para trás. Use [Agachar] para deixar o bote, soque-o para fazê-lo largar "
"como um item."

#: mods/ENTITIES/mcl_boats/init.lua:634
msgid "Boat"
msgstr "Bote"

#: mods/ENTITIES/mcl_boats/init.lua:640
msgid "Water vehicle"
msgstr "Veículo aquático"

#: mods/ENTITIES/mcl_boats/init.lua:649
msgid ""
"Chest Boats are used to travel on the surface of water. And transport goods"
msgstr ""
"Botes com baú são usados para viajar na superfície da água. E transportar "
"coisas"

#: mods/ENTITIES/mcl_boats/init.lua:650
msgid ""
"Rightclick on a water source to place the boat. Rightclick the boat to enter "
"it. Use [Left] and [Right] to steer, [Forwards] to speed up and [Backwards] "
"to slow down or move backwards. Use [Sneak] to leave the boat, punch the "
"boat to make it drop as an item. Use [Sneak] + [Rightclick] to open the "
"boat's chest"
msgstr ""
"Clique com o botão direito em uma fonte de água para posicionar o bote. "
"Clique com o botão direito no bote para entrar nele. Use [Esquerda] e "
"[Direita] para conduzir, [Frente] para acelerar e [Trás] para desacelerar e "
"se mover para trás. Use [Agachar] para deixar o bote, soque o bote para o "
"fazer soltar como um item. Use [Agachar] + [Botão Direito] para abrir o baú "
"do bote"

#: mods/ENTITIES/mcl_boats/init.lua:651
msgid "Chest Boat"
msgstr "Bote com Baú"

#: mods/ENTITIES/mcl_boats/init.lua:663
msgid " Boat"
msgstr " Bote"
