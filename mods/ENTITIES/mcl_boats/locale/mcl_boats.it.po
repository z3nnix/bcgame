#: mods/ENTITIES/mcl_boats/init.lua:166
msgid "Sneak to dismount"
msgstr "Accovacciati per scendere"

#: mods/ENTITIES/mcl_boats/init.lua:632
msgid "Boats are used to travel on the surface of water."
msgstr "Le barche sono utilizzate per viaggiare sulla superficie dell'acqua."

#: mods/ENTITIES/mcl_boats/init.lua:633
msgid ""
"Rightclick on a water source to place the boat. Rightclick the boat to enter "
"it. Use [Left] and [Right] to steer, [Forwards] to speed up and [Backwards] "
"to slow down or move backwards. Use [Sneak] to leave the boat, punch the "
"boat to make it drop as an item."
msgstr ""
"Clicca col tasto destro su una sorgente d'acqua per piazzare la barca. "
"Clicca col tasto destro per entrarci. Utilizza [Sinistra] e [Destra] per "
"governare, [Avanti] per accelerare ed [Indietro] per rallentare od "
"indietreggiare. Utilizza [Accovacciati] per uscire dalla barca, colpiscila "
"per causarne la caduta come elemento."

#: mods/ENTITIES/mcl_boats/init.lua:634
msgid "Boat"
msgstr "Barca"

#: mods/ENTITIES/mcl_boats/init.lua:640
msgid "Water vehicle"
msgstr "Veicolo acquatico"

#: mods/ENTITIES/mcl_boats/init.lua:649
msgid ""
"Chest Boats are used to travel on the surface of water. And transport goods"
msgstr ""
"Le barche con baule sono utilizzate per viaggiare sulla superficie "
"dell'acqua e trasportare oggetti"

#: mods/ENTITIES/mcl_boats/init.lua:650
msgid ""
"Rightclick on a water source to place the boat. Rightclick the boat to enter "
"it. Use [Left] and [Right] to steer, [Forwards] to speed up and [Backwards] "
"to slow down or move backwards. Use [Sneak] to leave the boat, punch the "
"boat to make it drop as an item. Use [Sneak] + [Rightclick] to open the "
"boat's chest"
msgstr ""
"Clicca col tasto destro su una sorgente d'acqua per piazzare la barca. "
"Clicca col tasto destro per entrarci. Utilizza [Sinistra] e [Destra] per "
"governare, [Avanti] per accelerare ed [Indietro] per rallentare od "
"indietreggiare. Utilizza [Accovacciati] per uscire dalla barca, colpiscila "
"per causarne la caduta come elemento. Clicca col tasto destro tenendo "
"premuto [Accovacciati] per aprire il baule della barca"

#: mods/ENTITIES/mcl_boats/init.lua:651
msgid "Chest Boat"
msgstr "Barca con baule"

#: mods/ENTITIES/mcl_boats/init.lua:663
msgid " Boat"
msgstr " Barca"
