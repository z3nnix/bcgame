#: mods/ENTITIES/mcl_boats/init.lua:166
msgid "Sneak to dismount"
msgstr "Agáchate para desmontar"

#: mods/ENTITIES/mcl_boats/init.lua:632
msgid "Boats are used to travel on the surface of water."
msgstr "Las barcas se utilizan para viajar en la superficie del agua."

#: mods/ENTITIES/mcl_boats/init.lua:633
msgid ""
"Rightclick on a water source to place the boat. Rightclick the boat to enter "
"it. Use [Left] and [Right] to steer, [Forwards] to speed up and [Backwards] "
"to slow down or move backwards. Use [Sneak] to leave the boat, punch the "
"boat to make it drop as an item."
msgstr ""
"Haga clic derecho en el agua para colocar el barco. Haga clic derecho en el "
"barco para entrar. Utilice [Izquierda] y [Derecha] para dirigir, [Adelante] "
"para acelerar y [Atrás] para reducir la velocidad o retroceder. Agachese "
"para bajarse, golpee el barco para llevartelo."

#: mods/ENTITIES/mcl_boats/init.lua:634
msgid "Boat"
msgstr "Barca"

#: mods/ENTITIES/mcl_boats/init.lua:640
msgid "Water vehicle"
msgstr "Vehículo acuático"

#: mods/ENTITIES/mcl_boats/init.lua:649
msgid ""
"Chest Boats are used to travel on the surface of water. And transport goods"
msgstr ""
"Los botes con cofre se utilizan para viajar sobre el agua. y transportar "
"mercancías"

#: mods/ENTITIES/mcl_boats/init.lua:650
msgid ""
"Rightclick on a water source to place the boat. Rightclick the boat to enter "
"it. Use [Left] and [Right] to steer, [Forwards] to speed up and [Backwards] "
"to slow down or move backwards. Use [Sneak] to leave the boat, punch the "
"boat to make it drop as an item. Use [Sneak] + [Rightclick] to open the "
"boat's chest"
msgstr ""
"Haz clic derecho en una fuente de agua para colocar el bote. Haz clic "
"derecho en el bote para subirte. Usa [Izquierda] y [Derecha] para dirigir, "
"[Adelante] para acelerar y [Atrás] para reducir la velocidad o moverte hacia "
"atrás. Usa [Agacharse] para salir del bote, y golpea el bote para que se "
"convierta en un ítem. Usa [Agacharse] + [Clic derecho] para abrir el cofre "
"del bote"

#: mods/ENTITIES/mcl_boats/init.lua:651
msgid "Chest Boat"
msgstr "Bote con cofre"

#: mods/ENTITIES/mcl_boats/init.lua:663
msgid " Boat"
msgstr " Bote"
