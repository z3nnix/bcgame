#: mods/HUD/mcl_info/init.lua:111
msgid ""
"Set debug bit mask: 0 = disable, 1 = player coords, 2 = coordinates, 3 = "
"biome name, 4 = all"
msgstr ""
"デバッグビットマスクを設定: 0 = 無効, 1 = プレイヤー座標, 2 = 座標, 3 = "
"バイオーム名, 4 = すべて"

#: mods/HUD/mcl_info/init.lua:112 mods/HUD/mcl_info/init.lua:129
msgid "<bitmask>"
msgstr "<ビットマスク>"

#: mods/HUD/mcl_info/init.lua:119 mods/HUD/mcl_info/init.lua:138
msgid "Error! Possible values are integer numbers from @1 to @2"
msgstr "エラー！指定できる値は@1から@2の整数値です"

#: mods/HUD/mcl_info/init.lua:128
msgid "Set location bit mask: 0 = disable, 1 = coordinates"
msgstr "位置ビットマスクを設定: 0 = 無効, 1 = 座標"
