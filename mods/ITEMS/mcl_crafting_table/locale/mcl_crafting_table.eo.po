#: mods/ITEMS/mcl_crafting_table/init.lua:10
msgid "Crafting"
msgstr "Kunmetado"

#: mods/ITEMS/mcl_crafting_table/init.lua:20
msgid "Inventory"
msgstr "Portaĵujo"

#: mods/ITEMS/mcl_crafting_table/init.lua:33
msgid "Recipe book"
msgstr "Receptaro"

#: mods/ITEMS/mcl_crafting_table/init.lua:36
msgid "Fill Craft Grid"
msgstr "Plenigi la metian kradraĵon"

#: mods/ITEMS/mcl_crafting_table/init.lua:80
msgid "Workbench"
msgstr "Labortablo"

#: mods/ITEMS/mcl_crafting_table/init.lua:81
msgid "3×3 crafting grid"
msgstr "3×3a kunmeta krado"

#: mods/ITEMS/mcl_crafting_table/init.lua:82
msgid ""
"A workbench is a block which grants you access to a 3×3 crafting grid "
"which allows you to perform advanced crafts."
msgstr ""
"Labortablo estas bloko kiu donas al vi aliron al 3×3a kunmeta krado kiu "
"ebligas vin fari altnivelajn kunmetojn."

#: mods/ITEMS/mcl_crafting_table/init.lua:83
msgid "Rightclick the workbench to access the 3×3 crafting grid."
msgstr "Dekstre klaku la kunmetan tablon por aliri la kunmetejon kun 3×3 ingoj."
