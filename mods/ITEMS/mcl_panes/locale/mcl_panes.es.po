#: mods/ITEMS/mcl_panes/init.lua:211
msgid ""
"Glass panes are thin layers of glass which neatly connect to their neighbors "
"as you build them."
msgstr ""
"Los paneles de cristal son capas delgadas de cristal que se conectan "
"perfectamente a otros cristales a medida que los construye."

#: mods/ITEMS/mcl_panes/init.lua:216
msgid ""
"Stained glass panes are thin layers of stained glass which neatly connect to "
"their neighbors as you build them. They come in many different colors."
msgstr ""
"Los paneles de cristal son capas delgadas de cristal que se conectan "
"perfectamente a otros cristales a medida que los construye. Vienen en muchos "
"colores diferentes."

#: mods/ITEMS/mcl_panes/init.lua:217
msgid "Stained Glass Pane"
msgstr "Panel de cristal tintado de manchado"

#: mods/ITEMS/mcl_panes/init.lua:249
msgid "Iron Bars"
msgstr "Barrotes de hierro"

#: mods/ITEMS/mcl_panes/init.lua:250
msgid "Iron bars neatly connect to their neighbors as you build them."
msgstr ""
"Los barrotes de hierro se conectan perfectamente a sus vecinos a medida que "
"los construyes."

#: mods/ITEMS/mcl_panes/init.lua:264
msgid "Glass Pane"
msgstr "Panel de cristal"

